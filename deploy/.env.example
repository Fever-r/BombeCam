# BombeCam Docker settings. Copy to .env and fill in what you need.
# Sign-in can also be done on the web page instead of here.
# The gateway image. Empty: BombeCam's published image, newest 1.x release
# (ghcr.io/fever-r/bombecam-gateway:1), which has the Osaio server key and app
# ID built in. To stay on one release: ghcr.io/fever-r/bombecam-gateway:1.0.0.
# To run an image you built yourself (README, Docker): bombecam-gateway:local
BOMBECAM_GATEWAY_IMAGE=
# Osaio server key: leave both empty to use the key built into the image or one
# saved under Settings > Server key (kept in the gateway's data volume).
# Set ONE of these only to pin a key. See docs/technical/CONFIGURATION.md.
BOMBECAM_SERVER_KEY=
# Path inside the container to a file holding the key (mount it read-only).
BOMBECAM_SERVER_KEY_FILE=
# Osaio app ID: works like the server key. Leave both empty to use the app ID
# built into the image or one saved under Settings > App ID (kept in the
# gateway's data volume). Set ONE of these only to pin an app ID.
BOMBECAM_APP_ID=
# Path inside the container to a file holding the app ID (mount it read-only).
BOMBECAM_APP_ID_FILE=
OSAIO_EMAIL=
OSAIO_PASSWORD=
OSAIO_COUNTRY=
# Exact IDs selected from authenticated discovery; empty starts no camera streams.
OSAIO_ENROLLED=
CAMERA_IP=
# Camera IDs to stream without audio (comma-separated), for cameras whose audio track misbehaves.
BOMBECAM_VIDEO_ONLY_DEVICES=
STRICT_MANUAL=false
GATEWAY_HTTP_PORT=8654
# 127.0.0.1 = web UI on this machine only; 0.0.0.0 = reachable from the LAN
GATEWAY_HTTP_BIND=127.0.0.1
# BombeCam's administrator (its own sign-in, not an Osaio login). Normally
# created on the page at http://127.0.0.1:8654 on this machine. If you only
# open the page from other devices, set a password here: it creates the
# administrator at start-up when there is none yet (then you can remove it).
BOMBECAM_ADMIN_NAME=
BOMBECAM_ADMIN_PASSWORD=
# cloud (default, works out of the box) or mqtt (experimental local broker; needs --profile local-mqtt)
CONTROL_TRANSPORT=cloud
MQTT_HOST_PORT=1883
MQTTS_HOST_PORT=8883
# Bind address for MQTTS (port 8883) TLS listener used by physical Wi-Fi cameras on LAN.
# Internal MQTT (port 1883) remains bound strictly to 127.0.0.1.
MQTTS_BIND_ADDRESS=0.0.0.0
# Client-facing URL; change if HLS_PORT or host changes.
OSAIO_HLS_BASE=http://127.0.0.1:8888
# Internal RTSP publishing target for gateway/FFmpeg
BOMBECAM_RTSP_PUBLISH_BASE=rtsp://127.0.0.1:8554
OSAIO_PUBLISH_RTSP_BASE=rtsp://127.0.0.1:8554
# Advertised consumer RTSP base for external NVRs (leave blank to dynamically derive from request Host header)
BOMBECAM_RTSP_CONSUMER_BASE=
OSAIO_RTSP_BASE=
# ==============================================================================
# "Block cloud video" on a Linux router (optional --profile isolation).
# OpenWrt / GL.iNet routers don't need this: the web UI applies the setting on
# the router over SSH. Use this only if the cameras route through a Linux box.
# ==============================================================================
# bombecam-net local API (status and POST /api/v1/net/block-cloud-video)
BOMBECAM_NET_API_HOST=127.0.0.1
BOMBECAM_NET_API_PORT=8653
# Bearer token required for the POST route (recommended)
BOMBECAM_NET_API_KEY=
# Camera interface name (e.g. eth0.30, vlan30, wlan0). Leave blank to auto-detect.
CAMERA_VLAN_IF=
# Camera subnet CIDR (e.g. 10.0.30.0/24 or 192.168.1.0/24). Leave blank to auto-detect.
CAMERA_SUBNET=
# Camera gateway/router IP on camera interface (e.g. 10.0.30.1 or 192.168.1.1). Leave blank to auto-detect.
CAMERA_GATEWAY_IP=
# Outbound WAN interface for NAT masquerade (e.g. eth0, wan0). Leave blank to auto-detect.
WAN_INTERFACE=
# Set to 1 only if this box routes the camera subnet and has no NAT of its own.
BOMBECAM_MASQUERADE=0
# REQUIRED for --profile isolation: cameras as "Name=MAC", comma-separated
# (e.g. Front Door=aa:bb:cc:dd:ee:ff). The web page lists each camera's MAC
# in the Firewall tab once it has streamed.
CAMERA_MAC=
